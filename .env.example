# Copie este arquivo para .env e ajuste se necessário.

# Porta HTTP da API
PORT=3000

# Banco de dados (SQLite em arquivo local; para PostgreSQL troque o provider no schema.prisma)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
# Validade do access token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Segredo compartilhado com o gateway de pagamento (valida o webhook /pagamentos/webhook)
PAYMENT_WEBHOOK_SECRET="segredo-webhook-mock"

# Gateway de pagamento mock: tempo máximo (ms) e nº de tentativas antes de desistir
PAYMENT_TIMEOUT_MS=2000
PAYMENT_MAX_TENTATIVAS=2

# Pontos de fidelidade: pontos ganhos por R$ 1,00 pago e valor (R$) de cada ponto no resgate
FIDELIDADE_PONTOS_POR_REAL=1
FIDELIDADE_VALOR_PONTO=0.05
