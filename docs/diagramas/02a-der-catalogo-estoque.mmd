erDiagram
  UNIDADES ||--o{ CARDAPIO_ITENS : "oferece"
  PRODUTOS ||--o{ CARDAPIO_ITENS : "aparece em"
  UNIDADES ||--o{ ESTOQUES : "possui estoque próprio"
  PRODUTOS ||--o{ ESTOQUES : "estocado em"
  UNIDADES ||--o{ MOVIMENTACOES_ESTOQUE : "registra"
  PRODUTOS ||--o{ MOVIMENTACOES_ESTOQUE : "movimenta"
  UNIDADES ||--o{ PEDIDOS : "recebe"
  PEDIDOS |o--o{ MOVIMENTACOES_ESTOQUE : "origina"

  UNIDADES {
    int id PK
    string nome
    string cidade
    string uf
    string regiao
    string tipo_cozinha "COMPLETA|REDUZIDA"
    bool ativa
  }
  PRODUTOS {
    int id PK
    string nome
    string categoria
    decimal preco_base
    bool exige_cozinha_completa
    bool sazonal
    bool ativo
  }
  CARDAPIO_ITENS {
    int id PK
    int unidade_id FK "UK(unidade,produto)"
    int produto_id FK
    decimal preco_local "nullable = preco_base"
    bool disponivel
    datetime disponivel_de "janela sazonal"
    datetime disponivel_ate
  }
  ESTOQUES {
    int id PK
    int unidade_id FK "UK(unidade,produto)"
    int produto_id FK
    int quantidade "CHECK >= 0 via UPDATE condicional"
    int estoque_minimo
  }
  MOVIMENTACOES_ESTOQUE {
    int id PK
    int unidade_id FK
    int produto_id FK
    string tipo "ENTRADA|SAIDA|AJUSTE|ESTORNO"
    int quantidade
    int saldo_apos
    int pedido_id FK "nullable"
    int usuario_id
  }
  PEDIDOS {
    int id PK
    int unidade_id FK
  }
